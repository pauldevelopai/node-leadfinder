# LeadFinder — copy to .env. Never commit the real file.

# Shared with the tracker so the tracker_token cookie verifies (hosted only).
JWT_SECRET=

# Claude. Server-managed when hosted; locally you can enter a key in the browser.
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5

# The shared box Postgres. Pointing at the tracker's database is intentional —
# ensureSchema is all IF NOT EXISTS, so the Node ADOPTS the existing leadfinder
# tables and their data rather than rebuilding them.
DATABASE_URL=

# Optional
PORT=4106
UPLOAD_MAX_MB=100
